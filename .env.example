# Endereço onde a árvore vai ficar (precisa apontar para o IP do servidor)
DOMAIN=arvore.exemplo.com
# Nome da família, abaixo de "Family Book · Genealogia"
FAMILY_SUBTITLE=Família Duarte Melo
# Pessoa que aparece primeiro (código da pessoa na árvore)
DEFAULT_PERSON=leo
# Senha de instalação: só quem souber pode criar a conta de administrador
SETUP_KEY=troque-por-uma-frase-longa
# Tamanho máximo de cada arquivo enviado (MB)
MAX_UPLOAD_MB=20
# E-mail automático (aprovação de pedidos e aviso de pedido novo). Deixe em branco para mandar os convites à mão.
# Na Strato: crie uma caixa de e-mail no domínio (ex.: arvore@seudominio.de) e use os dados dela.
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Pasta de entrada dos relatos (dentro do container). Padrão: /data/relatos-entrada = ~/arvore/data/relatos-entrada no servidor.
# RELATOS_INBOX=/data/relatos-entrada
